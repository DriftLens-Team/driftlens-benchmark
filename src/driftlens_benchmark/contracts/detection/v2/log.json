{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "log_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "result_id": {
      "const": "r1"
    },
    "concept_id": {
      "enum": [
        "sa_food_orders",
        "sa_drink_orders",
        "sa_customers_active",
        "sa_customers_new",
        "sa_order_value_avg",
        "sa_revenue_growth_wow",
        "sa_tax_rate_avg"
      ]
    },
    "decision": {
      "enum": [
        "drift",
        "no_drift",
        "abstain"
      ]
    },
    "reason_code": {
      "enum": [
        "definition_mismatch",
        "equivalent_definition",
        "unsupported_sql",
        "insufficient_evidence",
        "evidence_conflict",
        "constant_baseline",
        "numeric_signal"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "log_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "field": {
            "enum": [
              "sql",
              "definition_note",
              "reported_values",
              "answer_text"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "log_id",
          "field",
          "quote"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "evidence_summary": {
      "type": "string",
      "minLength": 1
    },
    "slot_differences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string",
            "minLength": 1
          },
          "baseline": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "observed": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "slot",
          "baseline",
          "observed"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "log_id",
    "result_id",
    "concept_id",
    "decision",
    "reason_code",
    "evidence",
    "evidence_summary",
    "slot_differences"
  ],
  "additionalProperties": false
}
