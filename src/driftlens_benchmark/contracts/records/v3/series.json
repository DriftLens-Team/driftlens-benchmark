{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "concept_id": {
        "enum": [
          "sa_food_orders",
          "sa_drink_orders",
          "sa_customers_active",
          "sa_customers_new",
          "sa_order_value_avg",
          "sa_revenue_growth_wow",
          "sa_tax_rate_avg"
        ]
      },
      "log_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "minItems": 0,
        "uniqueItems": true
      }
    },
    "required": [
      "concept_id",
      "log_ids"
    ],
    "additionalProperties": false
  },
  "minItems": 7,
  "maxItems": 7
}
