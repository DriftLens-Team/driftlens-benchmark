{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "log_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "team": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "sql": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "answer_text": {
      "type": "string",
      "minLength": 1
    },
    "definition_note": {
      "type": "string",
      "minLength": 1
    },
    "reported_values": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept_id": {
            "const": "large_orders"
          },
          "value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854776000
          },
          "period": {
            "type": "string",
            "pattern": "^\\d{4}-W\\d{2}$"
          }
        },
        "required": [
          "concept_id",
          "value",
          "period"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1
    },
    "referenced_concepts": {
      "const": [
        "large_orders"
      ]
    }
  },
  "required": [
    "log_id",
    "timestamp",
    "agent_id",
    "team",
    "request",
    "sql",
    "answer_text",
    "definition_note",
    "reported_values",
    "referenced_concepts"
  ],
  "additionalProperties": false
}
