{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "records/v2"
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept_id": {
            "const": "large_orders"
          },
          "version": {
            "const": "v1"
          },
          "comparison": {
            "const": ">="
          },
          "threshold": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854776000
          },
          "amount_unit": {
            "const": "integer_cents"
          }
        },
        "required": [
          "concept_id",
          "version",
          "comparison",
          "threshold",
          "amount_unit"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1
    }
  },
  "required": [
    "contract_version",
    "definitions"
  ],
  "additionalProperties": false
}
