{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "case": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "type": "string",
      "format": "date"
    },
    "weeks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 520
    },
    "effective_at": {
      "type": "string",
      "format": "date"
    },
    "control": {
      "const": true
    },
    "level": {
      "const": "L3"
    },
    "split": {
      "const": "development"
    }
  },
  "required": [
    "version",
    "suite_id",
    "case",
    "dataset",
    "start",
    "weeks",
    "effective_at",
    "control",
    "level",
    "split"
  ],
  "additionalProperties": false
}
