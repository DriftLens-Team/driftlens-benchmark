{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "orders-v1"
    },
    "orders": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "source_lock": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "version",
    "dataset_id",
    "schema_version",
    "orders",
    "schema",
    "source_lock"
  ],
  "additionalProperties": false
}
