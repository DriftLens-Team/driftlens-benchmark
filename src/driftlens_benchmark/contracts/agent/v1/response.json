{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "ok"
        },
        "observation": {
          "type": "object",
          "properties": {
            "sql": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "answer_text": {
              "type": "string",
              "minLength": 1
            },
            "definition_note": {
              "type": "string",
              "minLength": 1
            },
            "reported_values": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "concept_id": {
                    "const": "large_orders"
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854776000
                  },
                  "period": {
                    "type": "string",
                    "pattern": "^\\d{4}-W\\d{2}$"
                  }
                },
                "required": [
                  "concept_id",
                  "value",
                  "period"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 1
            },
            "referenced_concepts": {
              "const": [
                "large_orders"
              ]
            }
          },
          "required": [
            "sql",
            "answer_text",
            "definition_note",
            "reported_values",
            "referenced_concepts"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "status",
        "observation"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "unsupported_request",
                "model_auth_failed",
                "model_request_failed",
                "model_timeout",
                "invalid_action",
                "sql_error",
                "answer_validation_failed",
                "turn_limit",
                "request_timeout",
                "protocol_error",
                "duplicate_request_id",
                "request_limit"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "status",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
